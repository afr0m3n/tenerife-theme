# Copy this file to .env.deploy and fill real values locally.
# Never commit .env.deploy.

DEPLOY_CONNECTION="sftp"
DEPLOY_HOST="example.com"
DEPLOY_PORT="222"

DEPLOY_USER="ftp-or-sftp-user"

# Keep the real password only in .env.deploy.
# The deploy scripts redact the password from lftp output.
DEPLOY_PASSWORD=""

REMOTE_THEME_DIR="/public_html/wp-content/themes/amarilla-tenerife"
REMOTE_THEME_SLUG="amarilla-tenerife"

LOCAL_THEME_DIR="/srv/apps/tenerife-theme"
BACKUP_BASE_DIR="/srv/backups/tenerife-theme"

LFTP_PARALLEL="2"
