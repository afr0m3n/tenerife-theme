{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1320px"
    },
    "color": {
      "palette": [
        { "slug": "yellow", "color": "#F5B800", "name": "Žlutá Amarilla" },
        { "slug": "yellow-soft", "color": "#FFE08A", "name": "Žlutá světlá" },
        { "slug": "deep", "color": "#0F2A3D", "name": "Tmavá modrozelená" },
        { "slug": "deep-soft", "color": "#1B3D54", "name": "Modrozelená střední" },
        { "slug": "cream", "color": "#F8F2E4", "name": "Krémová" },
        { "slug": "cream-soft", "color": "#FBF7ED", "name": "Krémová světlá" },
        { "slug": "coral", "color": "#E07856", "name": "Korálová (akcent)" },
        { "slug": "white", "color": "#FFFFFF", "name": "Bílá" },
        { "slug": "black", "color": "#0A1A26", "name": "Černá" },
        { "slug": "gray-line", "color": "rgba(15, 42, 61, 0.12)", "name": "Šedá (linky)" },
        { "slug": "gray-text", "color": "rgba(15, 42, 61, 0.65)", "name": "Šedá text" }
      ],
      "custom": false,
      "defaultPalette": false,
      "defaultGradients": false
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "name": "Fraunces",
          "slug": "fraunces",
          "fontFamily": "'Fraunces', Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Fraunces",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/fraunces-latin-wght.woff2"],
              "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+2074,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
            },
            {
              "fontFamily": "Fraunces",
              "fontStyle": "italic",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/fraunces-latin-wght-italic.woff2"],
              "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+2074,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
            },
            {
              "fontFamily": "Fraunces",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/fraunces-latin-ext-wght.woff2"],
              "unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF"
            },
            {
              "fontFamily": "Fraunces",
              "fontStyle": "italic",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/fraunces-latin-ext-wght-italic.woff2"],
              "unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF"
            }
          ]
        },
        {
          "name": "DM Sans",
          "slug": "dm-sans",
          "fontFamily": "'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif",
          "fontFace": [
            {
              "fontFamily": "DM Sans",
              "fontStyle": "normal",
              "fontWeight": "100 1000",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/dm-sans-latin-wght.woff2"],
              "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+2074,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
            },
            {
              "fontFamily": "DM Sans",
              "fontStyle": "italic",
              "fontWeight": "100 1000",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/dm-sans-latin-wght-italic.woff2"],
              "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+2074,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
            },
            {
              "fontFamily": "DM Sans",
              "fontStyle": "normal",
              "fontWeight": "100 1000",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/dm-sans-latin-ext-wght.woff2"],
              "unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF"
            },
            {
              "fontFamily": "DM Sans",
              "fontStyle": "italic",
              "fontWeight": "100 1000",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/dm-sans-latin-ext-wght-italic.woff2"],
              "unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF"
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Malé" },
        { "slug": "medium", "size": "1rem", "name": "Střední" },
        { "slug": "large", "size": "1.25rem", "name": "Velké" },
        { "slug": "x-large", "size": "clamp(1.5rem, 3vw, 2rem)", "name": "Extra velké" },
        { "slug": "xx-large", "size": "clamp(2.5rem, 5vw, 3.75rem)", "name": "Nadpis sekce", "fluid": false },
        { "slug": "display", "size": "clamp(3rem, 7vw, 6rem)", "name": "Display (hero)", "fluid": false }
      ]
    },
    "spacing": {
      "spacingScale": {
        "operator": "*",
        "increment": 1.5,
        "steps": 7,
        "mediumStep": 1.5,
        "unit": "rem"
      },
      "padding": true,
      "margin": true,
      "blockGap": true,
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--cream)",
      "text": "var(--wp--preset--color--deep)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--dm-sans)",
      "fontSize": "1rem",
      "lineHeight": "1.6"
    },
    "spacing": {
      "padding": {
        "top": "0",
        "bottom": "0",
        "left": "var(--wp--preset--spacing--40)",
        "right": "var(--wp--preset--spacing--40)"
      }
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fraunces)",
          "fontWeight": "500",
          "lineHeight": "1.05",
          "letterSpacing": "-0.02em",
          "fontSize": "var(--wp--preset--font-size--display)"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fraunces)",
          "fontWeight": "500",
          "lineHeight": "1.05",
          "letterSpacing": "-0.02em",
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fraunces)",
          "fontWeight": "500",
          "lineHeight": "1.15",
          "fontSize": "1.5rem"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fraunces)",
          "fontWeight": "500",
          "fontSize": "1.25rem"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--deep)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--yellow)"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--yellow)",
          "text": "var(--wp--preset--color--deep)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--dm-sans)",
          "fontWeight": "500",
          "fontSize": "0.875rem"
        },
        "border": {
          "radius": "999px"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "right": "1.5rem",
            "bottom": "0.75rem",
            "left": "1.5rem"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--deep)",
            "text": "var(--wp--preset--color--cream)"
          }
        }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Hlavička", "area": "header" },
    { "name": "footer", "title": "Patička", "area": "footer" },
    { "name": "topbar", "title": "Horní lišta (kontakt + jazyky)", "area": "uncategorized" }
  ],
  "customTemplates": [
    { "name": "page-contact", "title": "Stránka: Kontakt", "postTypes": ["page"] },
    { "name": "page-about", "title": "Stránka: O nás", "postTypes": ["page"] },
    { "name": "page-services", "title": "Stránka: Služby", "postTypes": ["page"] }
  ]
}
